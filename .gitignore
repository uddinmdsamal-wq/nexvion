
# ==================================
# OPENENGINE GLOBAL GIT IGNORE
# ==================================

# Environment files
.env
.env.*
!.env.example

# Git directories (anywhere)
.git/
.git

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE settings
.idea/
.vscode/
.android/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Build directories
build/
dist/
out/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*

# Python packaging
*.egg-info/
.eggs/
wheels/

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
.gitignore
